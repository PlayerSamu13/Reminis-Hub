# Base de desarrollo. Para pruebas y demostracion usa reminishub_test.
DB_URL=jdbc:postgresql://localhost:5432/reminishub_dev
DB_USER=nombre_usuario
DB_PASSWORD=
# Firma del JWT propio: minimo 32 bytes UTF-8. Generalo aparte y no lo subas a Git.
# Ejemplo en PowerShell: [Convert]::ToBase64String([byte[]](1..48 | ForEach-Object { Get-Random -Max 256 }))
RH_JWT_SECRET=
# Vigencia del token en minutos (60 si se omite).
RH_JWT_MINUTOS=60
# Perfil https: rutas locales al PKCS12 y su clave. Nunca los agregues a Git.
RH_TLS_KEYSTORE=C:\ruta\privada\reminishub-local.p12
RH_TLS_PASSWORD=
